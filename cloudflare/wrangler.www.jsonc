// Worker `thienhoangky-www`: www.thienhoangky.fun → 301 về https://thienhoangky.fun (giữ đường dẫn). Không có nội dung.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thienhoangky-www",
  "main": "src/www.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.thienhoangky.fun", "custom_domain": true }],
  "observability": { "enabled": false }
}
