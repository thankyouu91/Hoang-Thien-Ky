// Worker `thienhoangky`: game ở https://thienhoangky.fun (sau Cloudflare Access) + API /api/* + D1.
// Hướng dẫn deploy: cloudflare/README.md. Hợp đồng API: docs/api.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thienhoangky",
  "main": "src/game.ts",
  "compatibility_date": "2026-11-01",
  // Không có đường vào nào ngoài tên miền đã gắn Access: tắt *.workers.dev và URL xem trước của từng phiên bản.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "thienhoangky.fun", "custom_domain": true }],
  // Trước khi đẩy: build proto/dist, chép _headers, kiểm giới hạn số file và dung lượng.
  "build": { "command": "node scripts/chuan-bi.mjs" },
  "assets": {
    "directory": "../proto/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Chỉ API chạy Worker; asset do Cloudflare phục vụ thẳng sau Access (không tốn lượt request của Worker).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thienhoangky",
      "database_id": "aa2c1b16-661a-4df8-94a3-37ee20cc0f5e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Team Zero Trust và AUD tag của ứng dụng Access "Thiên Hoang Ký – chơi thử". Trống thì /api/* trả 503 (đóng khi thiếu).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Log do Worker tự ghi; tắt invocation log để header JWT, email và đường dẫn không vào Workers Logs.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
