{
  "name": "thien-hoang-ky-desktop",
  "productName": "Thiên Hoang Ký",
  "version": "0.1.0",
  "private": true,
  "description": "Thiên Hoang Ký, bản chơi trên máy tính",
  "author": "Thiên Hoang Ký",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "npm --prefix ../proto run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "fun.thienhoangky.play",
    "productName": "Thiên Hoang Ký",
    "files": [
      "main.cjs",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../proto/dist",
        "to": "game"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Thiên Hoang Ký",
      "artifactName": "ThienHoangKy-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
