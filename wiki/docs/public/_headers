# Header cho file tĩnh phục vụ thẳng (không qua Worker): JS, CSS, font có mã băm trong tên, và hình.
# Trang HTML và chỉ mục tìm kiếm đi qua Worker (worker/index.ts), Worker tự gắn header.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/hinh/*
  Cache-Control: public, max-age=86400
