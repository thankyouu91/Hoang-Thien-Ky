{
 "quy_tac": [
  "khoá = đường dẫn trong assets/pixellab bỏ .png; ảnh 64×64 nền trong, neo giữa cạnh dưới",
  "hệ = region.element của file điểm (Cấm Khu là hon_don); chưa có bộ riêng thì dùng hệ \"*\"",
  "bậc: mỏ (mo_linh_thach, mo_quang, mo_duoc) cấp 1–2 → \"1\", 3–4 → \"2\", 5 → \"3\", chưa ai chiếm → \"1\"; cua_bi_canh theo tier (thap, vua, cao); loại khác \"0\"",
  "thiếu bậc thì lùi về bậc \"1\" (mỏ) rồi hệ \"*\"",
  "dáng = ds[bam(id) % ds.length], bam(id) = Math.imul(id + 1, 2654435761) >>> 0: cùng điểm luôn cùng hình, lên cấp chỉ đổi bậc",
  "son_mon không nằm ở đây: điểm có tông môn dùng tong_mon/<mô hình>"
 ],
